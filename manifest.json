{
  "manifest_version": 3,
  "name": "Ravelry Yarn Weight Filter",
  "version": "1.5",
  "description": "Shows how many grams of yarn Ravelry patterns and projects use, filters search results by yarn weight, and estimates yarn cost from EU store prices.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hobbii.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ravelry Yarn Weight Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ravelry.com/patterns/*",
        "https://www.ravelry.com/projects/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
